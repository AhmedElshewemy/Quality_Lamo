{
  "name": "seafood-qms-server",
  "version": "1.0.0",
  "description": "Backend API for Seafood QMS",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "reset-for-production": "node dist/scripts/reset-for-production.js",
    "reset-for-production:dev": "tsx src/scripts/reset-for-production.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "helmet": "^8.3.0",
    "express-rate-limit": "^8.7.0",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/cors": "^2.8.19",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/better-sqlite3": "^9.6.0",
    "typescript": "^5.2.2",
    "tsx": "^4.23.15"
  }
}
