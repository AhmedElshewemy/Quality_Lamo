# ===========================================
# Seafood QMS - Environment Variables Template
# ===========================================
# Copy this file to .env and fill in the values
# ===========================================

# -------------------------------------------
# Application Settings
# -------------------------------------------
VITE_APP_NAME=نظام إدارة الجودة - مطعم سي فود
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# -------------------------------------------
# Admin Account (Primary Administrator)
# -------------------------------------------
VITE_ADMIN_EMAIL=admin@example.com
VITE_ADMIN_PASSWORD=ChangeThisPassword123!
VITE_ADMIN_NAME=مدير النظام

# -------------------------------------------
# Quality Manager Account
# -------------------------------------------
VITE_MANAGER_EMAIL=manager@example.com
VITE_MANAGER_PASSWORD=ChangeThisPassword123!
VITE_MANAGER_NAME=مدير الجودة

# -------------------------------------------
# Quality Engineers Accounts
# -------------------------------------------
VITE_ENGINEER1_EMAIL=engineer1@example.com
VITE_ENGINEER1_PASSWORD=ChangeThisPassword123!
VITE_ENGINEER1_NAME=مهندس جودة 1
VITE_ENGINEER1_BRANCH=branch-1

VITE_ENGINEER2_EMAIL=engineer2@example.com
VITE_ENGINEER2_PASSWORD=ChangeThisPassword123!
VITE_ENGINEER2_NAME=مهندس جودة 2
VITE_ENGINEER2_BRANCH=branch-2

VITE_ENGINEER3_EMAIL=engineer3@example.com
VITE_ENGINEER3_PASSWORD=ChangeThisPassword123!
VITE_ENGINEER3_NAME=مهندس جودة 3
VITE_ENGINEER3_BRANCH=branch-3

# -------------------------------------------
# Firebase Configuration (Optional)
# -------------------------------------------
# Get these values from Firebase Console > Project Settings > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# -------------------------------------------
# Backend API (Optional)
# -------------------------------------------
VITE_API_URL=/api

# -------------------------------------------
# Security Settings
# -------------------------------------------
VITE_SESSION_TIMEOUT=86400000
VITE_MAX_LOGIN_ATTEMPTS=5
VITE_PASSWORD_MIN_LENGTH=8

# -------------------------------------------
# Upload Settings
# -------------------------------------------
VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
